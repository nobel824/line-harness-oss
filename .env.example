# L Harness environment variable names only.
# Keep every value empty. Store real secrets outside the repository.
# See docs/environment-contract.md for required/optional classification.

# Worker: core API and LINE integration
API_KEY=
LEGACY_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
WORKER_URL=
LIFF_URL=

# Worker: admin browser and server-side self-update (optional unless enabled)
ADMIN_ORIGIN=
ADMIN_ALLOW_CROSS_SITE=
ADMIN_COOKIE_SAMESITE=
ADMIN_BROWSER_AUTH_MODE=
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
ADMIN_SSO_SECRET=
ADMIN_API_KEY=
ADMIN_NOTIFY_LINE_USER_ID=
CF_API_TOKEN=
CF_ACCOUNT_ID=
WORKER_NAME=
ADMIN_PAGES_PROJECT=
LIFF_PAGES_PROJECT=
D1_DATABASE_ID=
MANIFEST_URL=
WORKER_PUBLIC_URL=
ADMIN_PUBLIC_URL=
LIFF_PUBLIC_URL=

# Worker: optional integrations and limits
STRIPE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_HARNESS_URL=
IG_HARNESS_URL=
IG_HARNESS_LINK_SECRET=
LOG_RETENTION_DAYS=
QUOTA_FRIENDS_MAX=
QUOTA_MONTHLY_MESSAGES_MAX=
QUOTA_NOTICE_URL=

# Web: copy the needed names to apps/web/.env.local or Pages variables
NEXT_PUBLIC_API_URL=
# SECURITY: Do not define NEXT_PUBLIC_ADMIN_API_KEY. NEXT_PUBLIC_* values are
# embedded in the browser bundle and cannot safely authenticate /admin/update/*.
# Web build and verify:readiness fail if the name exists, even with an empty value.
# Use the local CLI; do not enable the browser update UI until its routes have
# independently implemented and verified server-side authentication.
# Browser self-update is code-locked off. There is no environment switch to
# enable it; re-enabling requires reviewed server-side auth and a code change.
NEXT_PUBLIC_BASE_PATH=
NEXT_BASE_PATH=
NEXT_PUBLIC_API_MODE=

# LIFF build: public build-time values
# Worker Assets / release workflows
VITE_LIFF_ID=
VITE_BOT_BASIC_ID=
VITE_CALENDAR_CONNECTION_ID=
# Standalone LIFF app
VITE_API_BASE=
VITE_DEFAULT_LIFF_ID=
VITE_BASE_PATH=

# MCP client
LINE_HARNESS_API_URL=
LINE_HARNESS_API_KEY=
LINE_HARNESS_ACCOUNT_ID=

# Plugin template Worker / MCP runtime
# See packages/plugin-template/README.md
EXTERNAL_API_KEY=
LINE_ACCOUNT_ID=

# create-line-harness and release/build overrides
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_NAME=
LINE_HARNESS_REPO_URL=
LINE_HARNESS_ALLOW_SOURCE_PUBLISH=

# Build metadata (normally generated by CI/git/build tooling)
APP_VERSION=
APP_COMMIT_SHA=
APP_BUILD_TIME=
GITHUB_SHA=
CF_PAGES_COMMIT_SHA=
